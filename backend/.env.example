# Database Configuration
POSTGRES_USER=artha_user
POSTGRES_PASSWORD=artha_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arthaai
DATABASE_URL=postgresql+psycopg2://artha_user:artha_password@localhost:5432/arthaai

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=artha_mutual_funds

# Security & JWT
SECRET_KEY=dev_secret_key_change_in_production_1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
