# ==============================================================================
# ArthaAI Environment Configuration
# ==============================================================================

# Application & Environment
PROJECT_NAME="ArthaAI Platform"
ENVIRONMENT="production"
LOG_LEVEL="INFO"

# Database Configuration (PostgreSQL Docker)
POSTGRES_DB="arthaai"
POSTGRES_USER="artha_user"
POSTGRES_PASSWORD="change_this_secure_password_in_production"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+psycopg2://artha_user:change_this_secure_password_in_production@postgres:5432/arthaai"

# JWT Authentication & Security
SECRET_KEY="generate_a_random_64_character_hex_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-2.5-flash"
GEMINI_API_KEY="your_google_gemini_api_key_here"

# AWS Infrastructure (Uses IAM EC2 Role in Production - No hardcoded keys)
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="arthaai-user-storage-195231312586"
